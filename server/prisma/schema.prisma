generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum IncomeSubtype {
  REGULAR
  DIVIDEND
  CAPITAL_GAIN
  RETURN_OF_CAPITAL
}

enum TaxClassification {
  QUALIFIED
  ORDINARY
  TAX_EXEMPT
  RETURN_OF_CAPITAL
  CAPITAL_GAIN
}

enum PendingDividendStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum DividendElection {
  REINVEST
  CASH
}

enum TaxAdvantageType {
  TRADITIONAL
  ROTH
  HSA
  PLAN_529
}

enum InvestmentActivityType {
  DIVIDEND
  SALE
  PURCHASE
}

model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("USD")
  color     String?
  isJoint          Boolean     @default(false)
  isManaged        Boolean     @default(false)
  isTaxAdvantaged  Boolean     @default(false)
  taxAdvantageType TaxAdvantageType?
  isActive         Boolean     @default(true)
  isHidden         Boolean     @default(false)

  // Balance tracking
  balanceUpdatedAt     DateTime?

  // Settlement cash (investment accounts only)
  cashBalance          Decimal?  @db.Decimal(12, 2)
  cashBalanceUpdatedAt DateTime?

  // Credit card settings (type = CREDIT_CARD only)
  closingDay           Int?      // day of month (1–28) the billing cycle closes
  dueDay               Int?      // day of month the payment is due
  linkedBankAccountId  String?   // which CHECKING/SAVINGS account pays this card

  // Investment dividend settings (type = INVESTMENT only)
  dividendElection     DividendElection? // REINVEST, CASH, or null (ask each time)
  defaultCashAccountId String?           // where cash dividends are deposited

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  expenses              Expense[]
  incomes               Income[]
  holdings              InvestmentHolding[]
  manualInvestments     ManualInvestment[]
  investmentActivities  InvestmentActivity[]
  gainSnapshots         RealizedGainSnapshot[]
  pendingDividends      PendingDividend[]
  statementOverrides    StatementOverride[]
  transfersFrom         Transfer[]     @relation("TransferFrom")
  transfersTo           Transfer[]     @relation("TransferTo")
  transferRulesFrom     TransferRule[] @relation("TransferRuleFrom")
  transferRulesTo       TransferRule[] @relation("TransferRuleTo")
  balanceAdjustments    BalanceAdjustment[]

  // Self-relations: CC → bank, investment → bank
  linkedBankAccount    Account?   @relation("CreditCardBankLink", fields: [linkedBankAccountId], references: [id])
  ccPayingAccounts     Account[]  @relation("CreditCardBankLink")
  defaultCashAccount   Account?   @relation("InvestmentCashLink", fields: [defaultCashAccountId], references: [id])
  investmentAccounts   Account[]  @relation("InvestmentCashLink")

  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  icon      String?
  color     String?
  kind      CategoryKind @default(EXPENSE)
  isDefault      Boolean      @default(false)
  ignoreInBudget Boolean      @default(false)
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  expenses Expense[]
  incomes  Income[]

  @@map("categories")
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  vendor      String   @default("")
  date        DateTime
  notes       String?
  categoryId  String?
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isReimbursementExpected Boolean @default(false)
  reimbursementNote       String?
  ignoreInBudget          Boolean @default(false)

  recurrenceRuleId   String?
  transactionGroupId String?
  parentExpenseId    String?

  recurrenceRule   RecurrenceRule?   @relation(fields: [recurrenceRuleId], references: [id])
  transactionGroup TransactionGroup? @relation("GroupExpenses", fields: [transactionGroupId], references: [id])
  primaryForGroups TransactionGroup[] @relation("GroupPrimary")
  category         Category?         @relation(fields: [categoryId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  parentExpense    Expense?          @relation("ExpenseOffsets", fields: [parentExpenseId], references: [id], onDelete: Cascade)
  offsets          Expense[]         @relation("ExpenseOffsets")
  tags             ExpenseTag[]

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([parentExpenseId])
  @@map("expenses")
}

model Income {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String?
  source     String?
  date       DateTime
  notes      String?
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactionGroupId String?

  subtype         IncomeSubtype       @default(REGULAR)
  taxClassification TaxClassification?
  taxableAmount   Decimal?            @db.Decimal(12, 2)
  isCashReceived  Boolean             @default(true)
  activityId      String?

  category         Category?          @relation(fields: [categoryId], references: [id])
  transactionGroup TransactionGroup?  @relation(fields: [transactionGroupId], references: [id])
  account          Account            @relation(fields: [accountId], references: [id])
  activity         InvestmentActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  tags             IncomeTag[]

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
  @@index([activityId])
  @@map("incomes")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses ExpenseTag[]
  incomes  IncomeTag[]

  @@map("tags")
}

model ExpenseTag {
  expenseId String
  tagId     String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
  @@map("expense_tags")
}

model IncomeTag {
  incomeId String
  tagId    String

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([incomeId, tagId])
  @@map("income_tags")
}

model TransactionGroup {
  id               String   @id @default(cuid())
  notes            String?
  primaryExpenseId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  expenses       Expense[] @relation("GroupExpenses")
  primaryExpense Expense?  @relation("GroupPrimary", fields: [primaryExpenseId], references: [id], onDelete: SetNull)
  incomes        Income[]

  @@map("transaction_groups")
}

model RecurrenceRule {
  id            String    @id @default(cuid())
  description   String
  vendor        String    @default("")
  amount        Decimal   @db.Decimal(12, 2)
  frequency     Frequency
  interval      Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  nextOccurrence DateTime
  categoryId    String
  accountId     String
  group         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses Expense[]

  @@map("recurrence_rules")
}

// ── Budget models ──────────────────────────────────────────────────────────────
// Personal and Joint budgets are set separately; Total is always derived as
// personal + (joint × jointSplitRatio).  Monthly overrides allow per-month
// amounts on top of the annual default (annualAmount / 12).

enum BudgetType {
  PERSONAL
  JOINT
}

model AnnualBudget {
  id           String    @id @default(cuid())
  type         BudgetType
  year         Int
  // Nullable: users who prefer month-by-month control may leave this unset,
  // in which case effectiveAnnual = sum of all MonthlyBudget overrides.
  annualAmount Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  monthlyOverrides MonthlyBudget[]

  @@unique([type, year])
  @@map("annual_budgets")
}

model MonthlyBudget {
  id             String       @id @default(cuid())
  annualBudgetId String
  month          Int          // 1–12
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  annualBudget AnnualBudget @relation(fields: [annualBudgetId], references: [id], onDelete: Cascade)

  @@unique([annualBudgetId, month])
  @@map("monthly_budgets")
}

model BudgetSettings {
  id              String   @id @default(cuid())
  // Fraction of joint expenses counted toward the user's Total budget (default 50/50).
  // Stored as a decimal (0.5 = 50%).  Future UI will expose this as editable.
  jointSplitRatio Decimal  @default(0.5) @db.Decimal(4, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("budget_settings")
}

model InvestmentSettings {
  id                        String   @id @default(cuid())
  // Portfolio value used as the denominator for withdrawal rate calculations.
  // Null = use the live portfolio value from investment accounts.
  withdrawalRateDenominator Decimal? @db.Decimal(14, 2)
  // Target annual withdrawal rate stored as a ratio (e.g. 0.0400 = 4.00%).
  // Null = no target configured.
  withdrawalRateTarget      Decimal? @db.Decimal(5, 4)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("investment_settings")
}

// ── Investment models ───────────────────────────────────────────────────────────

model InvestmentHolding {
  id         String   @id @default(cuid())
  accountId  String
  ticker     String
  name       String
  type       String?
  assetClass String?
  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account          Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lots             InvestmentLot[]
  activities       InvestmentActivity[]
  pendingDividends PendingDividend[]

  @@unique([accountId, ticker])
  @@map("investment_holdings")
}

model ManualInvestment {
  id           String   @id @default(cuid())
  accountId    String
  name         String
  assetClass   String?
  totalCost    Decimal? @db.Decimal(12, 2)
  marketValue  Decimal  @db.Decimal(12, 2)
  instrumentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@map("manual_investments")
}

model InvestmentLot {
  id           String    @id @default(cuid())
  holdingId    String
  quantity     Decimal   @db.Decimal(18, 6)
  costPerShare Decimal   @db.Decimal(18, 6)
  // Null for managed/robo-advisor holdings where lot-level acquisition dates
  // are unavailable. A null date signals that short/long-term gain calculation
  // cannot be performed for this lot.
  acquiredDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  holding  InvestmentHolding   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  activity InvestmentActivity?

  @@map("investment_lots")
}

// ── Realized gain snapshots ─────────────────────────────────────────────────
// Stores YTD realized gain/loss totals pasted in from a robo-advisor dashboard
// (e.g. Wealthfront). One row per account per year; upserted on each update.
model RealizedGainSnapshot {
  id            String   @id @default(cuid())
  accountId     String
  year          Int
  longTermGain  Decimal? @db.Decimal(12, 2)
  shortTermGain Decimal? @db.Decimal(12, 2)
  longTermLoss  Decimal? @db.Decimal(12, 2)
  shortTermLoss Decimal? @db.Decimal(12, 2)
  snapshotDate  DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, year])
  @@map("realized_gain_snapshots")
}

model TickerPrice {
  id          String   @id @default(cuid())
  ticker      String   @unique
  price       Decimal  @db.Decimal(12, 4)
  priceDate   DateTime
  priceSource String   @default("YAHOO") // "YAHOO" | "TIINGO"
  updatedAt   DateTime @updatedAt

  @@map("ticker_prices")
}

// Stores daily adjusted-close price history per ticker for growth chart rendering.
// Populated via the backfill endpoint (YTD on first run) and lazily gap-filled
// when a growth chart is requested and the latest row is stale.
model TickerPriceHistory {
  id         String   @id @default(cuid())
  ticker     String
  date       DateTime @db.Date
  closePrice Decimal  @db.Decimal(12, 4)
  createdAt  DateTime @default(now())

  @@unique([ticker, date])
  @@index([ticker])
  @@map("ticker_price_history")
}

model InvestmentActivity {
  id            String                 @id @default(cuid())
  accountId     String
  holdingId     String?
  lotId         String?                @unique
  ticker        String
  type          InvestmentActivityType
  date          DateTime
  shares        Decimal?               @db.Decimal(18, 6)
  pricePerShare Decimal?               @db.Decimal(18, 6)
  amount        Decimal                @db.Decimal(12, 2)
  fees          Decimal?               @db.Decimal(12, 2)
  costBasis     Decimal?               @db.Decimal(12, 2)
  shortTermGain Decimal?               @db.Decimal(12, 2)
  longTermGain  Decimal?               @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  account          Account            @relation(fields: [accountId], references: [id])
  holding          InvestmentHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  lot              InvestmentLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  incomes          Income[]
  pendingDividend  PendingDividend?

  @@index([accountId])
  @@index([date])
  @@index([holdingId])
  @@index([lotId])
  @@map("investment_activities")
}

// ── Asset allocation models ──────────────────────────────────────────────────

model AssetClass {
  id           String   @id @default(cuid())
  name         String
  slug         String?  @unique  // set for system classes (e.g. "us-large-cap")
  isSystem     Boolean  @default(false)
  parentId     String?
  displayOrder Int      @default(0)
  color        String?
  parent       AssetClass?  @relation("AssetClassHierarchy", fields: [parentId], references: [id])
  children     AssetClass[] @relation("AssetClassHierarchy")
  instrumentWeights InstrumentAssetClassWeight[]
  target       AssetClassTarget?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("asset_classes")
}

model AssetClassTarget {
  id           String     @id @default(cuid())
  assetClassId String     @unique
  assetClass   AssetClass @relation(fields: [assetClassId], references: [id], onDelete: Cascade)
  targetPct    Decimal    @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("asset_class_targets")
}

model Instrument {
  id                String   @id @default(cuid())
  primaryTicker     String   @unique
  name              String?
  isManual          Boolean  @default(false)
  isActive          Boolean  @default(true)
  // Set after each successful Tiingo dividend scan; used to enforce the daily scan window.
  lastDividendScanAt    DateTime?
  // Set after every scan attempt (success or failure); used to enforce a 1-hour retry
  // backoff so rate-limited tickers are not retried on every subsequent app load.
  lastDividendAttemptAt DateTime?
  tickers           InstrumentTicker[]
  weights           InstrumentAssetClassWeight[]
  holdings          InvestmentHolding[]
  manualInvestments ManualInvestment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("instruments")
}

model InstrumentTicker {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  ticker       String     @unique
  createdAt    DateTime   @default(now())

  @@map("instrument_tickers")
}

model InstrumentAssetClassWeight {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  assetClassId String
  assetClass   AssetClass @relation(fields: [assetClassId], references: [id], onDelete: Cascade)
  weight       Decimal    @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([instrumentId, assetClassId])
  @@map("instrument_asset_class_weights")
}

// ── Pending dividend suggestions ────────────────────────────────────────────
// Populated by scanning Tiingo daily price data (divCash > 0) for each active
// holding. Users review, edit if needed, and confirm or dismiss each entry.
// Confirmed entries produce an InvestmentActivity (DIVIDEND) + linked Income.
model PendingDividend {
  id             String                @id @default(cuid())
  holdingId      String
  accountId      String
  ticker         String
  exDate         DateTime              @db.Date
  perShareAmount Decimal               @db.Decimal(18, 6)
  sharesAtExDate Decimal               @db.Decimal(18, 6)
  estimatedTotal Decimal               @db.Decimal(12, 2)
  status         PendingDividendStatus @default(PENDING)
  // Estimated payment date: computed as exDate + 4 calendar days at creation time
  // (Tiingo does not provide payment dates; this is a best-effort estimate).
  paymentDate    DateTime?             @db.Date
  dismissedAt    DateTime?
  confirmedAt    DateTime?
  activityId     String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  holding  InvestmentHolding   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  account  Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activity InvestmentActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([holdingId, exDate])
  @@index([accountId])
  @@map("pending_dividends")
}

// ── Cash flow models ─────────────────────────────────────────────────────────

// Template for a recurring inter-account transfer (e.g. monthly paycheck split
// to a joint account). Generates Transfer instances via the same pattern as
// RecurrenceRule → Expense.
model TransferRule {
  id             String    @id @default(cuid())
  description    String
  amount         Decimal   @db.Decimal(12, 2)
  frequency      Frequency
  interval       Int       @default(1)
  startDate      DateTime
  endDate        DateTime?
  nextOccurrence DateTime
  fromAccountId  String
  toAccountId    String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fromAccount Account    @relation("TransferRuleFrom", fields: [fromAccountId], references: [id])
  toAccount   Account    @relation("TransferRuleTo", fields: [toAccountId], references: [id])
  transfers   Transfer[]

  @@map("transfer_rules")
}

// A single transfer of funds between two bank accounts. May be a one-off entry
// or an instance generated from a TransferRule. isConfirmed distinguishes
// projected (future) transfers from those that have actually cleared.
model Transfer {
  id             String    @id @default(cuid())
  description    String
  amount         Decimal   @db.Decimal(12, 2)
  date           DateTime
  notes          String?
  fromAccountId  String
  toAccountId    String
  transferRuleId String?
  isConfirmed    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fromAccount  Account       @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount    Account       @relation("TransferTo", fields: [toAccountId], references: [id])
  transferRule TransferRule? @relation(fields: [transferRuleId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

// A user-entered balance adjustment for cash flow planning (e.g. a planned
// cash injection from an external source). Persisted so the user can edit or
// remove it later. Amount is positive for inflows, negative for outflows.
model BalanceAdjustment {
  id          String   @id @default(cuid())
  accountId   String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  description String   @default("Cash injection")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@map("balance_adjustments")
}

// Allows the user to override the calculated statement total for a specific
// credit card billing period. Used when posted dates cause transactions to fall
// in a different period than entered, making the computed total inaccurate.
model StatementOverride {
  id          String   @id @default(cuid())
  accountId   String   // Must be a CREDIT_CARD account
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodStart])
  @@index([accountId])
  @@map("statement_overrides")
}
