generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum IncomeSource {
  DIVIDENDS
  INTEREST
  CAPITAL_GAINS
  GIFTS
  OTHER
}

model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("USD")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  expenses Expense[]
  incomes  Income[]

  @@map("accounts")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  color     String?
  isDefault Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  expenses Expense[]

  @@map("categories")
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  vendor      String   @default("")
  date        DateTime
  notes       String?
  categoryId  String?
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isReimbursementExpected Boolean @default(false)
  reimbursementNote       String?

  recurrenceRuleId   String?
  transactionGroupId String?
  parentExpenseId    String?

  recurrenceRule   RecurrenceRule?   @relation(fields: [recurrenceRuleId], references: [id])
  transactionGroup TransactionGroup? @relation(fields: [transactionGroupId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  parentExpense    Expense?          @relation("ExpenseOffsets", fields: [parentExpenseId], references: [id], onDelete: Cascade)
  offsets          Expense[]         @relation("ExpenseOffsets")
  tags             ExpenseTag[]

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([parentExpenseId])
  @@map("expenses")
}

model Income {
  id        String       @id @default(cuid())
  amount    Decimal      @db.Decimal(12, 2)
  source    IncomeSource
  date      DateTime
  notes     String?
  accountId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactionGroupId String?

  transactionGroup TransactionGroup? @relation(fields: [transactionGroupId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  tags             IncomeTag[]

  @@index([date])
  @@index([accountId])
  @@map("incomes")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses ExpenseTag[]
  incomes  IncomeTag[]

  @@map("tags")
}

model ExpenseTag {
  expenseId String
  tagId     String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
  @@map("expense_tags")
}

model IncomeTag {
  incomeId String
  tagId    String

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([incomeId, tagId])
  @@map("income_tags")
}

model TransactionGroup {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  incomes  Income[]

  @@map("transaction_groups")
}

model RecurrenceRule {
  id            String    @id @default(cuid())
  description   String
  vendor        String    @default("")
  amount        Decimal   @db.Decimal(12, 2)
  frequency     Frequency
  interval      Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  nextOccurrence DateTime
  categoryId    String
  accountId     String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses Expense[]

  @@map("recurrence_rules")
}

model Budget {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@map("budgets")
}
