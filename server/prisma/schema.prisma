generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CategoryKind {
  EXPENSE
  INCOME
}

model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("USD")
  color     String?
  isJoint   Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  expenses Expense[]
  incomes  Income[]

  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  icon      String?
  color     String?
  kind      CategoryKind @default(EXPENSE)
  isDefault      Boolean      @default(false)
  ignoreInBudget Boolean      @default(false)
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  expenses Expense[]
  incomes  Income[]

  @@map("categories")
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  vendor      String   @default("")
  date        DateTime
  notes       String?
  categoryId  String?
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isReimbursementExpected Boolean @default(false)
  reimbursementNote       String?
  ignoreInBudget          Boolean @default(false)

  recurrenceRuleId   String?
  transactionGroupId String?
  parentExpenseId    String?

  recurrenceRule   RecurrenceRule?   @relation(fields: [recurrenceRuleId], references: [id])
  transactionGroup TransactionGroup? @relation("GroupExpenses", fields: [transactionGroupId], references: [id])
  primaryForGroups TransactionGroup[] @relation("GroupPrimary")
  category         Category?         @relation(fields: [categoryId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  parentExpense    Expense?          @relation("ExpenseOffsets", fields: [parentExpenseId], references: [id], onDelete: Cascade)
  offsets          Expense[]         @relation("ExpenseOffsets")
  tags             ExpenseTag[]

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([parentExpenseId])
  @@map("expenses")
}

model Income {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String?
  source     String?
  date       DateTime
  notes      String?
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactionGroupId String?

  category         Category?         @relation(fields: [categoryId], references: [id])
  transactionGroup TransactionGroup? @relation(fields: [transactionGroupId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  tags             IncomeTag[]

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
  @@map("incomes")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses ExpenseTag[]
  incomes  IncomeTag[]

  @@map("tags")
}

model ExpenseTag {
  expenseId String
  tagId     String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
  @@map("expense_tags")
}

model IncomeTag {
  incomeId String
  tagId    String

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([incomeId, tagId])
  @@map("income_tags")
}

model TransactionGroup {
  id               String   @id @default(cuid())
  notes            String?
  primaryExpenseId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  expenses       Expense[] @relation("GroupExpenses")
  primaryExpense Expense?  @relation("GroupPrimary", fields: [primaryExpenseId], references: [id], onDelete: SetNull)
  incomes        Income[]

  @@map("transaction_groups")
}

model RecurrenceRule {
  id            String    @id @default(cuid())
  description   String
  vendor        String    @default("")
  amount        Decimal   @db.Decimal(12, 2)
  frequency     Frequency
  interval      Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  nextOccurrence DateTime
  categoryId    String
  accountId     String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses Expense[]

  @@map("recurrence_rules")
}

// ── Budget models ──────────────────────────────────────────────────────────────
// Personal and Joint budgets are set separately; Total is always derived as
// personal + (joint × jointSplitRatio).  Monthly overrides allow per-month
// amounts on top of the annual default (annualAmount / 12).

enum BudgetType {
  PERSONAL
  JOINT
}

model AnnualBudget {
  id           String    @id @default(cuid())
  type         BudgetType
  year         Int
  // Nullable: users who prefer month-by-month control may leave this unset,
  // in which case effectiveAnnual = sum of all MonthlyBudget overrides.
  annualAmount Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  monthlyOverrides MonthlyBudget[]

  @@unique([type, year])
  @@map("annual_budgets")
}

model MonthlyBudget {
  id             String       @id @default(cuid())
  annualBudgetId String
  month          Int          // 1–12
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  annualBudget AnnualBudget @relation(fields: [annualBudgetId], references: [id], onDelete: Cascade)

  @@unique([annualBudgetId, month])
  @@map("monthly_budgets")
}

model BudgetSettings {
  id              String   @id @default(cuid())
  // Fraction of joint expenses counted toward the user's Total budget (default 50/50).
  // Stored as a decimal (0.5 = 50%).  Future UI will expose this as editable.
  jointSplitRatio Decimal  @default(0.5) @db.Decimal(4, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("budget_settings")
}
